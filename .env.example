# Configuración de Supabase (Project Settings -> API). Solo la anon key: nunca la service_role.
VITE_SUPABASE_URL=https://tu-proyecto.supabase.co
VITE_SUPABASE_ANON_KEY=tu-anon-public-key

# Ya no existe un modo demo con atajos: todo inicio de sesión pasa por Supabase con el código del correo.
# Se mantiene en 'false' por compatibilidad con el workflow de Android.
VITE_MODO_DEMO=false

# Prueba E2E de dos usuarios (scripts/e2e_dos_usuarios.mjs). Solo en .env.local, nunca en el repo.
# Dos cuentas YA registradas y verificadas (correos en correos_invitados o @utp.edu.pe).
E2E_BASE_URL=http://localhost:5173
E2E_USER_A_EMAIL=
E2E_USER_A_PASSWORD=
E2E_USER_B_EMAIL=
E2E_USER_B_PASSWORD=
